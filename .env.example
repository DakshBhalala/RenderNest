# ==========================================
# RenderNest — Environment Configuration
# ==========================================

# Database
# Local SQLite fallback: "file:./dev.db"
# Production PostgreSQL: "postgresql://postgres:postgres@localhost:5432/rendernest?schema=public"
DATABASE_URL="file:./dev.db"

# Redis & Queue
# Optional for local dev (falls back to memory queue); required for production BullMQ
REDIS_URL="redis://localhost:6379"

# Application URLs
APP_URL="http://localhost:3000"
API_URL="http://localhost:3000"

# Authentication & Encryption
# Secret key used for JWT session cookies and HMAC URL signatures (minimum 32 characters)
AUTH_SECRET="rendernest-production-super-secure-jwt-auth-secret-key-32chars!"

# Storage Provider Configuration
# Supported options: 'local', 's3', 'r2'
STORAGE_PROVIDER="local"
LOCAL_STORAGE_PATH="./.storage"

# S3 Compatible Storage (AWS S3, Cloudflare R2, MinIO)
# S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"
# S3_BUCKET="rendernest-production-artifacts"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# Cloudflare R2
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY=""
# R2_SECRET_KEY=""

# Extraction Engine (LLM)
# Optional: Set to 'openai' with OPENAI_API_KEY to use GPT for structured JSON extraction.
# If omitted or empty, RenderNest utilizes its high-precision built-in heuristic local extractor.
EXTRACTION_PROVIDER="local"
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"

# Billing & Stripe (Optional)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Development / Demo Mode
# Set to 'true' to enable built-in demo keys and mock providers in isolated sandboxes
DEMO_MODE="false"
