# ==============================================================================
# RenderNest — Production Environment Configuration (.env.production)
# ==============================================================================
# Target Environment: Oracle Cloud Infrastructure (Ubuntu Linux / Docker Compose)
#
# INSTRUCTIONS:
# 1. Copy this file to .env.production on your production server:
#    cp .env.production.example .env.production
# 2. Generate cryptographically strong secrets using:
#    bash scripts/generate-production-secrets.sh
# 3. Fill in your Cloudflare R2 and domain settings.
# 4. Restrict file permissions: chmod 600 .env.production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SYSTEM & RUNTIME [REQUIRED]
# ------------------------------------------------------------------------------
NODE_ENV="production"
DEMO_MODE="false"

# ------------------------------------------------------------------------------
# 2. DOMAIN & APPLICATION URLS [REQUIRED]
# ------------------------------------------------------------------------------
# The primary public web application domain
APP_DOMAIN="rendernest.com"
APP_URL="https://rendernest.com"

# The public API domain (used by RapidAPI, SDKs, and integrations)
API_DOMAIN="api.rendernest.com"
API_URL="https://api.rendernest.com"

# Email for Let's Encrypt / ZeroSSL automatic ACME certificates via Caddy
ACME_EMAIL="admin@rendernest.com"

# ------------------------------------------------------------------------------
# 3. DATABASE (POSTGRESQL) [REQUIRED]
# ------------------------------------------------------------------------------
# Database user, password, and database name
POSTGRES_USER="rendernest"
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD="REPLACE_WITH_STRONG_POSTGRES_PASSWORD"
POSTGRES_DB="rendernest_production"

# Connection string used by Prisma inside the Docker bridge network
DATABASE_URL="postgresql://rendernest:REPLACE_WITH_STRONG_POSTGRES_PASSWORD@postgres:5432/rendernest_production?schema=public"

# ------------------------------------------------------------------------------
# 4. QUEUE & CACHE (REDIS) [REQUIRED]
# ------------------------------------------------------------------------------
# Redis connection string inside Docker bridge network
REDIS_PASSWORD="REPLACE_WITH_STRONG_REDIS_PASSWORD"
REDIS_URL="redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379"

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & HMAC SECRETS [REQUIRED]
# ------------------------------------------------------------------------------
# Cryptographic secret for signing JWT session cookies and auth tokens (min 32 chars)
# Generate with: openssl rand -hex 32
AUTH_SECRET="REPLACE_WITH_RANDOM_64_CHAR_HEX_SECRET"

# Secret key for local artifact HMAC-SHA256 URL signatures (fallback if R2 is unavailable)
# Generate with: openssl rand -hex 32
STORAGE_SECRET="REPLACE_WITH_RANDOM_64_CHAR_HEX_SECRET"

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE (CLOUDFLARE R2) [REQUIRED FOR PRODUCTION ARTIFACTS]
# ------------------------------------------------------------------------------
# Driver: 'r2' (Cloudflare R2) or 's3' (AWS S3) or 'local' (development fallback)
STORAGE_PROVIDER="r2"

# Cloudflare Account ID (found in Cloudflare dashboard URL or R2 overview)
R2_ACCOUNT_ID="REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID"

# Cloudflare R2 API Token with Object Read & Write permissions
R2_ACCESS_KEY="REPLACE_WITH_R2_ACCESS_KEY_ID"
R2_SECRET_KEY="REPLACE_WITH_R2_SECRET_ACCESS_KEY"

# Target R2 Bucket Name
R2_BUCKET="rendernest-production-artifacts"
S3_BUCKET="rendernest-production-artifacts"

# ------------------------------------------------------------------------------
# 7. RAPIDAPI MARKETPLACE INTEGRATION [REQUIRED FOR RAPIDAPI DISTRIBUTION]
# ------------------------------------------------------------------------------
# Secret header configured in RapidAPI Provider Dashboard (Target Endpoints > Security)
# Used by RenderNest to verify requests truly arrive from the RapidAPI gateway
RAPIDAPI_PROXY_SECRET="REPLACE_WITH_RAPIDAPI_PROXY_SECRET"

# ------------------------------------------------------------------------------
# 8. EXTRACTION & AI ENGINE [OPTIONAL]
# ------------------------------------------------------------------------------
# Default is 'local' (high-performance deterministic JSON-LD + Heuristic extractor)
# Set to 'openai' only if you wish to enable OpenAI LLM extraction fallback
EXTRACTION_PROVIDER="local"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# 9. DIRECT STRIPE BILLING [OPTIONAL - DISABLED FOR RAPIDAPI-FIRST LAUNCH]
# ------------------------------------------------------------------------------
# Keep empty while RapidAPI is the primary distribution channel
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
