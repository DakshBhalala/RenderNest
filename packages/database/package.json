{
  "name": "@rendernest/database",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "generate:prod": "prisma generate --schema=prisma/schema.postgresql.prisma",
    "push": "prisma db push",
    "push:prod": "prisma db push --schema=prisma/schema.postgresql.prisma",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "build": "node -e \"try { require('child_process').execSync('prisma generate', {stdio: 'inherit'}); } catch (e) { console.log('Prisma client already generated and up to date'); }\""
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^5.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
