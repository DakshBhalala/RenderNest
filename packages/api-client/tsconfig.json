{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@rendernest/shared": ["../shared/src/index.ts"],
      "@rendernest/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*"]
}
